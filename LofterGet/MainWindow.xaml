<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="LofterGet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:LofterGet"
        xmlns:lm="using:LofterGet.Model"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Title="LoferGet">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="GMain" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="spTitle" Orientation="Horizontal" Margin="4,0,0,0">
            <Image Source="/Picture2.ico" Width="20"/>
            <TextBlock x:Name="txtTitle" FontFamily="Segoe UI Variable Display" FontSize="14"
                       Margin="4,8" Text="LofterGet" VerticalAlignment="Top"/>
        </StackPanel>

        <InfoBar x:Name="ibError" Grid.Row="1" Severity="Error" Content="test"
                 Margin="4" Visibility="Collapsed"/>

        <TabView x:Name="tvMain" Grid.Row="2" IsAddTabButtonVisible="False"
                 TabWidthMode="SizeToContent" Margin="0,4,0,0">
            <TabViewItem Header="System Info" IsClosable="False"
                         VerticalAlignment="Stretch">
                <TextBox IsReadOnly="True" Margin="4" VerticalAlignment="Stretch"
                         AcceptsReturn="True" Text="{x:Bind viewModel.SysInfo, Mode=OneWay}"/>
            </TabViewItem>

            <TabViewItem Header="Lofter" IsClosable="False">
                <Grid Margin="8,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <TextBlock FontFamily="Segoe UI Variable Display" FontSize="20"
                               VerticalAlignment="Center"
                               Margin="4" Text="Referer:"/>
                    <TextBox Grid.Column="1" x:Name="txtReferer" FontFamily="Segoe UI Variable Display"
                             FontSize="20" Margin="4"/>

                    <TextBlock Grid.Row="1" FontFamily="Segoe UI Variable Display" FontSize="20" Margin="4"
                               Text="User-Agent:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtUserAgent" Margin="4"
                             FontFamily="Segoe UI Variable Display"
                             FontSize="20" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="2" FontFamily="Segoe UI Variable Display" FontSize="20" Margin="4"
                               Text="Source URL:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtSources" Margin="4"
                             Height="200" FontFamily="Segoe UI Variable Display"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             AcceptsReturn="True" TabIndex="0" FontSize="20"/>

                    <TextBlock Grid.Row="3" FontFamily="Segoe UI Variable Display"
                               VerticalAlignment="Center" FontSize="20" Margin="4"
                               Text="Output Folder:"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtOutputPath"
                             FontFamily="Segoe UI Variable Display" Margin="4"
                             TextChanged="txtOutputPath_TextChanged" FontSize="20"/>

                    <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="8">
                        <ProgressBar Value="50" x:Name="pBar" Width="300" Margin="8"/>
                        <Button x:Name="myButton"  Margin="4" FontSize="20"
                                FontFamily="Segoe UI Variable Display" Click="myButton_Click"
                                Style="{ThemeResource AccentButtonStyle}"
                                Content="Download"/>
                    </StackPanel>

                    <Grid Grid.Row="5" Grid.ColumnSpan="2" BorderBrush="{ThemeResource SystemAccentColor}"
                          BorderThickness="2" Margin="4">
                        <TextBox x:Name="txtConsole" FontFamily="Segoe UI Variable Display"
                                 FontSize="20" Margin="4" IsReadOnly="True" Height="Auto"
                                 AcceptsReturn="True" VerticalAlignment="Stretch"/>
                    </Grid>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Utility" IsClosable="False">
                <Grid Padding="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Top">
                        <Button Content="OneDrive" Command="{x:Bind viewModel.OneDriveUpdateCommand}"
                                Style="{ThemeResource AccentButtonStyle}"/>
                        <TextBox AcceptsReturn="True" Margin="0,8,0,0"
                                 Text="{x:Bind viewModel.OneUpdate, Mode=OneWay}"
                                 FontFamily="Segoe UI Variable Display" FontSize="20"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8">
                        <TextBlock Text="WWAN Data Class: " Margin="4,0"
                                   VerticalAlignment="Center"/>
                        <TextBox IsReadOnly="True" Text="{x:Bind viewModel.WwanDataClass, Mode=OneWay}"
                                 Margin="4,0"/>
                        <Button Content="Update" Command="{x:Bind viewModel.RefreshWwanDataClassCommand}"
                                Margin="4,0" Style="{ThemeResource AccentButtonStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8">
                        <TextBlock Text="Memory Bandwidth: " Margin="4,0"
                                   VerticalAlignment="Center"/>
                        <TextBox Text="{x:Bind viewModel.EffectiveTransferRate, Mode=TwoWay}"
                                 Margin="4,0"/>
                        <TextBlock Text="MT/s" Margin="4,0"
                                   VerticalAlignment="Center"/>
                        <TextBox Text="{x:Bind viewModel.Channels, Mode=TwoWay}"
                                 Margin="4,0"/>
                        <TextBlock Text="Channels" Margin="4,0"
                                   VerticalAlignment="Center"/>
                        <TextBox Text="{x:Bind viewModel.ChannelWidth, Mode=TwoWay}"
                                 Margin="4,0"/>
                        <TextBlock Text="bit/Channel" Margin="4,0"
                                   VerticalAlignment="Center"/>
                        <Button Content="Calculate" Command="{x:Bind viewModel.CalcBandwidthCommand}"
                                Margin="4,0" Style="{ThemeResource AccentButtonStyle}"/>
                        <TextBox Text="{x:Bind viewModel.CalculatedBandwidth, Mode=TwoWay}"
                                 Margin="4,0"/>
                        <TextBlock Text="GB/s" Margin="4,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8">
                        <Button Content="Chromium Version Detector"
                                Command="{x:Bind viewModel.ChromeDetectCommand}"
                                IsEnabled="{x:Bind viewModel.ChromiumDetectorEnabled, Mode=OneWay}"
                                Margin="4,0" Style="{ThemeResource AccentButtonStyle}"/>
                        <TextBlock Text="Chromium Version: " Margin="4,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind viewModel.ChromiumVersion, Mode=OneWay}"
                                   Margin="4,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Chrome GPU Driver Bug"  IsClosable="False">
                <Grid Padding="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Load" Command="{x:Bind viewModel.DisplayGpuDriverBugCommand}"
                                Style="{ThemeResource AccentButtonStyle}"/>
                        <ComboBox Margin="4" ItemsSource="{x:Bind viewModel.OsPlatforms, Mode=OneWay}"
                                  SelectedItem="{x:Bind viewModel.SelectedOsPlatform, Mode=TwoWay}"
                                  MinWidth="120" SelectionChanged="ComboBox_SelectionChanged"/>
                    </StackPanel>

                    <ListView Grid.Row="1" Margin="8" ItemsSource="{x:Bind viewModel.GpuBugs, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="lm:GpuDriverBugEntry">
                                <Grid Margin="4"
                                      Background="{ThemeResource AccentAcrylicBackgroundFillColorBaseBrush}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Bind id}" Margin="4" Padding="8"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{x:Bind description}" Margin="4"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ListView Grid.Row="2" ItemsSource="{x:Bind features}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="USB4 Capabilities" IsClosable="False">
                <Grid Padding="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="DisplayPort Capabilities:" VerticalAlignment="Center"/>
                        <TextBox Margin="4,0,0,0" Width="150"
                                 Text="{x:Bind viewModel.DpInLocalCapabilities, Mode=TwoWay}"/>
                        <Button Content="Update" Command="{x:Bind viewModel.UpdateUsb4CapsCommand}"
                                Style="{ThemeResource AccentButtonStyle}" Margin="4,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Apple Studio Display XDR: 96969525"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" Margin="0,4,0,0">
                        <Grid BorderThickness="2" CornerRadius="4" Padding="8,4"
                              BorderBrush="{ThemeResource AccentFillColorDefaultBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Protocol Adapter Version:" VerticalAlignment="Center"/>
                                <TextBox Margin="4,0,0,0" Width="150" IsReadOnly="True"
                                         Text="{x:Bind viewModel.Usb4DpInLocalCaps.Usb4Version, Mode=OneWay}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Margin="0,4,0,0" Orientation="Horizontal">
                                <TextBlock Text="DPCD Version:" VerticalAlignment="Center"/>
                                <TextBox Margin="4,0,0,0" Width="150" IsReadOnly="True"
                                         Text="{x:Bind viewModel.Usb4DpInLocalCaps.DpcdVersion, Mode=OneWay}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Margin="0,4,0,0" Orientation="Horizontal">
                                <TextBlock Text="Max Link Rate (8b/10b):" VerticalAlignment="Center"/>
                                <TextBox Margin="4,0,0,0" Width="150" IsReadOnly="True"
                                         Text="{x:Bind viewModel.Usb4DpInLocalCaps.MaxLinkRate8b10b, Mode=OneWay}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Margin="0,4,0,0" Orientation="Horizontal">
                                <TextBlock Text="Max Lane Count:" VerticalAlignment="Center"/>
                                <TextBox Margin="4,0,0,0" Width="150" IsReadOnly="True"
                                         Text="{x:Bind viewModel.Usb4DpInLocalCaps.MaxLaneCount, Mode=OneWay}"/>
                            </StackPanel>

                            <CheckBox Grid.Row="4" Margin="0,4,0,0" IsEnabled="False"
                                      Content="MST Capability (8b/10b)"
                                      IsChecked="{x:Bind viewModel.Usb4DpInLocalCaps.MstCap8b10b, Mode=OneWay}"/>

                            <CheckBox Grid.Row="5" Margin="0,4,0,0" IsEnabled="False"
                                      Content="Panel Replay Tunneling Optimization Support"
                                      IsChecked="{x:Bind viewModel.Usb4DpInLocalCaps.PanelReplayTunnelingOptSupport, Mode=OneWay}"/>

                            <CheckBox Grid.Row="6" Margin="0,4,0,0" IsEnabled="False"
                                      Content="128b/132b Link Layer &amp; 10 Gbps/Lane Support(UHBR10)"
                                      IsChecked="{x:Bind viewModel.Usb4DpInLocalCaps.LL128b132b, Mode=OneWay}"/>

                            <CheckBox Grid.Row="7" Margin="0,4,0,0" IsEnabled="False"
                                      Content="20 Gbps/Lane Support(UHBR20)"
                                      IsChecked="{x:Bind viewModel.Usb4DpInLocalCaps.Lane20Gbps, Mode=OneWay}"/>

                            <CheckBox Grid.Row="8" Margin="0,4,0,0" IsEnabled="False"
                                      Content="13.5 Gbps/Lane Support(UHBR13.5)"
                                      IsChecked="{x:Bind viewModel.Usb4DpInLocalCaps.Lane13_5Gbps, Mode=OneWay}"/>

                            <CheckBox Grid.Row="9" Margin="0,4,0,0" IsEnabled="False"
                                      Content="ALPM Support"
                                      IsChecked="{x:Bind viewModel.Usb4DpInLocalCaps.AlpmSupport, Mode=OneWay}"/>

                            <CheckBox Grid.Row="10" Margin="0,4,0,0" IsEnabled="False"
                                      Content="TPS3 Capability"
                                      IsChecked="{x:Bind viewModel.Usb4DpInLocalCaps.Tps3Cap8b10b, Mode=OneWay}"/>

                            <CheckBox Grid.Row="11" Margin="0,4,0,0" IsEnabled="False"
                                      Content="TPS4 Capability"
                                      IsChecked="{x:Bind viewModel.Usb4DpInLocalCaps.Tps4Cap8b10b, Mode=OneWay}"/>

                            <CheckBox Grid.Row="12" Margin="0,4,0,0" IsEnabled="False"
                                      Content="FEC Support (8b/10b)"
                                      IsChecked="{x:Bind viewModel.Usb4DpInLocalCaps.FecSupport8b10b, Mode=OneWay}"/>

                            <CheckBox Grid.Row="13" Margin="0,4,0,0" IsEnabled="False"
                                      Content="Secondary Split Capability"
                                      IsChecked="{x:Bind viewModel.Usb4DpInLocalCaps.SecondarySplitCapability, Mode=OneWay}"/>

                            <CheckBox Grid.Row="14" Margin="0,4,0,0" IsEnabled="False"
                                      Content="LTTPR Support"
                                      IsChecked="{x:Bind viewModel.Usb4DpInLocalCaps.LttprSupport, Mode=OneWay}"/>

                            <CheckBox Grid.Row="15" Margin="0,4,0,0" IsEnabled="False"
                                      Content="DP IN BW Allocation Mode Support"
                                      IsChecked="{x:Bind viewModel.Usb4DpInLocalCaps.DpInBwAllocationModeSupport, Mode=OneWay}"/>

                            <CheckBox Grid.Row="16" Margin="0,4,0,0" IsEnabled="False"
                                      Content="DSC Support"
                                      IsChecked="{x:Bind viewModel.Usb4DpInLocalCaps.DscSupported, Mode=OneWay}"/>

                        </Grid>
                    </ScrollViewer>

                </Grid>
            </TabViewItem>
        </TabView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Top">
            <Button Margin="8" Content="Light" Command="{x:Bind SetLightThemeCommand}"/>
            <Button Margin="0,8,8,8" Content="Dark" Command="{x:Bind SetDarkThemeCommand}"/>
        </StackPanel>
    </Grid>
</Window>
